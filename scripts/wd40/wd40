#!/usr/bin/env fish
function wd40
  argparse 'h/help' 'y/yes' -- $argv
  or return 1

  _cargo_installed

  if set -q _flag_h
    _print_help
  end

  if not set -q argv[-1]
    echo "Directory cannot be empty"
    return 3
  end

  if not set -q _flag_y
    _warning_prompt
  end

  set files (find $argv[-1] -name "Cargo.toml")
  set dirs (path dirname $files)

  for directory in $dirs
    pushd $directory
    cargo clean
    popd
  end
end


function _print_help
  echo 'Usage: wd40 [OPTIONS] [DIRECTORY... ]

Options:
  -h, --help
    Print this page
  -y, --yes
    Skips warning prompt
'
end

function _cargo_installed
  if not type -q cargo
    echo "Cargo is not installed, please install it before trying to use this tool."
    exit 2;
  end
end

function _warning_prompt
  echo "This will delete any other files that may be in the cargo target folder.
Make sure that you have backups of any important artifacts!
"
  read -n 1 -P "Continue... [y/N]" choice
  switch $choice
    case Y y
      echo "Procceding.."
    case "*"
      echo "Aborted."
      return 4;
  end
end

wd40 $argv
